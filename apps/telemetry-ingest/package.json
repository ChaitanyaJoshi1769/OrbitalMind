{
  "name": "@orbitalmind/telemetry-ingest",
  "version": "1.0.0",
  "description": "Real-time telemetry ingestion pipeline for OrbitalMind",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@orbitalmind/database": "workspace:*",
    "@orbitalmind/shared": "workspace:*",
    "express": "^4.18.2",
    "socket.io": "^4.7.0",
    "pino": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.0.0",
    "typescript": "^5.2.0",
    "tsx": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
